local function acceptQuest()
    if not Settings.AutoQuest then return end
    local questRemote = ReplicatedStorage:WaitForChild("NetworkInstances"):WaitForChild("RemoteEvents"):WaitForChild("Quests")
    local args = {
        [1] = "AcceptGrinding",
        [2] = Settings.SelectedQuest
    }
    questRemote:FireServer(unpack(args))
    print("[LARP] Quest accepted:", Settings.SelectedQuest)
end

-- Loop Principal
task.spawn(function()
    local noclipConnection
    local lastQuestTime = 0
    local stuckCounter = 0

    while task.wait(0.1) do
        local char = localPlayer.Character
        if not char or not char.Parent then continue end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end

        if Settings.AutoFarm then
            -- Noclip
            if not noclipConnection then
                noclipConnection = RunService.Stepped:Connect(function()
                    if char then
                        for _, v in pairs(char:GetDescendants()) do
                            if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
                        end
                    end
                end)
            end

            -- Auto Quest periódico
            if Settings.AutoQuest and (tick() - lastQuestTime > 5) then
                lastQuestTime = tick()
                acceptQuest()
            end

            equipWeapon()

            local target = getClosestEnemy()
            if target then
                local tHrp = target:FindFirstChild("HumanoidRootPart")
                if tHrp then
                    local distance = (tHrp.Position - hrp.Position).Magnitude
                    local destination = tHrp.CFrame * CFrame.new(0, 0, Settings.Distance)
                    
                    -- Calcula o tempo do voo baseado na porra da velocidade
                    local travelTime = distance / Settings.FlightSpeed
                    if travelTime <= 0 then travelTime = 0.01 end
                    
                    local startPos = hrp.Position
                    local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Linear)
                    local flyTween = TweenService:Create(hrp, tweenInfo, {CFrame = destination})
                    
                    flyTween:Play()
                    flyTween.Completed:Wait()
                    
                    -- Sistema anti-rubberband (se o script travar e voltar)
                    local endPos = hrp.Position
                    local expectedDist = (destination.Position - startPos).Magnitude
                    local actualDist = (endPos - startPos).Magnitude
                    
                    -- Se moveu menos da metade do que devia, a porra do anti-cheat puxou de volta
                    if actualDist < (expectedDist * 0.5) and expectedDist > 15 then
                        stuckCounter = stuckCounter + 1
                        Settings.FlightSpeed = math.max(50, Settings.FlightSpeed * 0.7) -- Dá uma desacelerada
                        
                        if stuckCounter >= 3 then
                            print("[LARP] Anti-cheat tá puxando. Velocidade reduzida pra:", math.floor(Settings.FlightSpeed))
                            stuckCounter = 0
                        end
                    else
                        -- Se tá voando de boa, começa a recuperar a velocidade aos poucos
                        stuckCounter = 0
                        if Settings.FlightSpeed < Settings.BaseSpeed then
                            Settings.FlightSpeed = math.min(Settings.BaseSpeed, Settings.FlightSpeed + 5)
                        end
                    end

                    -- Ataca
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        tool:Activate()
                    end
                end
            end
        else
            -- Desligar noclip
            if noclipConnection then
                noclipConnection:Disconnect()
                noclipConnection = nil
                for _, v in pairs(char:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = true end
                end
            end
        end
    end
end)

