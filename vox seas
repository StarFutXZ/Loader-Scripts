-- LÓGICA DO AUTO-FARM (Integrada)
-- ==========================================
local function equipWeapon()
    if not CombatSettings.AutoEquip then return end
    local char = localPlayer.Character
    local backpack = localPlayer:FindFirstChild("Backpack")
    if not backpack or not char or char:FindFirstChildOfClass("Tool") then return end

    for _, item in pairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            item.Parent = char
            task.wait(0.5)
            break
        end
    end
end

local function getTargetMobName()
    local selected = mobDropdown.Value
    if type(selected) == "table" then selected = selected[1] end
    return tostring(selected)
end

local function getClosestEnemy()
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    local hrp = char.HumanoidRootPart
    local closest = nil
    local dist = math.huge
