-- ==========================================
-- NOCLIP HARDCORE (RODA EM SEGUNDO PLANO)
-- ==========================================
task.spawn(function()
    local noclipConnection = nil

    while task.wait() do
        if Settings.Noclip then
            if not noclipConnection then
                -- Conecta no Heartbeat pra forçar a porra da colisão no mesmo frame que o jogo tenta setar
                noclipConnection = RunService.Heartbeat:Connect(function()
                    local char = localPlayer.Character
                    if char then
                        for _, v in pairs(char:GetDescendants()) do
                            if v:IsA("BasePart") then
                                if v.CanCollide then
                                    v.CanCollide = false
                                end
                                -- Força a porra da colisão do HumanoidRootPart também, caso o jogo tente resetar
                                if v.Name == "HumanoidRootPart" then
                                    v.CanCollide = false
                                end
                            end
                        end
                    end
                end)
            end
        else
            -- Desliga a porra do noclip e restaura a colisão
            if noclipConnection then
                noclipConnection:Disconnect()
                noclipConnection = nil
                
                local char = localPlayer.Character
                if char then
                    for _, v in pairs(char:GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.CanCollide = true
                        end
                    end
                end
            end
        end
    end
end)

-- Loop Principal (Farm e História)
task.spawn(function()
    local lastQuestTime = 0
    local stuckCounter = 0

    while task.wait() do
        local char = localPlayer.Character
        if not char or not char.Parent then continue end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end

        -- Lógica da História
        if Settings.AutoStory then
            if Settings.StoryState == "IDLE" then
                Settings.StoryState = "FLY_HOUSE"
                
            elseif Settings.StoryState == "FLY_HOUSE" then
                local dist = (Coords.House.Position - hrp.Position).Magnitude
                if dist > 5 then
                    local dir = (Coords.House.Position - hrp.Position).Unit
                    hrp.CFrame = CFrame.new(hrp.Position + dir * (Settings.FlightSpeed * 0.05), hrp.Position + dir)
                else
                    hrp.CFrame = Coords.House
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    Settings.StoryState = "ENTER_HOUSE"
                end

            elseif Settings.StoryState == "ENTER_HOUSE" then
                task.spawn(function()
                    task.wait(0.5)
                    enterHouse()
                    task.wait(1.5) 
                    Settings.StoryState = "FLY_NPC"
                end)

            elseif Settings.StoryState == "FLY_NPC" then
                local dist = (Coords.NPC.Position - hrp.Position).Magnitude
                if dist > 5 then
                    local dir = (Coords.NPC.Position - hrp.Position).Unit
                    hrp.CFrame = CFrame.new(hrp.Position + dir * (Settings.FlightSpeed * 0.05), hrp.Position + dir)
                else
                    hrp.CFrame = Coords.NPC
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    Settings.StoryState = "TALK_NPC"
                end

            elseif Settings.StoryState == "TALK_NPC" then
                task.spawn(function()
                    task.wait(0.5)
                    talkToNPC()
                    task.wait(1.5)
                    Settings.StoryState = "FLY_EXIT"
                end)

            elseif Settings.StoryState == "FLY_EXIT" then
                local dist = (Coords.ExitDoor.Position - hrp.Position).Magnitude
                if dist > 5 then
                    local dir = (Coords.ExitDoor.Position - hrp.Position).Unit
                    hrp.CFrame = CFrame.new(hrp.Position + dir * (Settings.FlightSpeed * 0.05), hrp.Position + dir)
                else
                    hrp.CFrame = Coords.ExitDoor
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    Settings.StoryState = "LEAVE_HOUSE"
                end

            elseif Settings.StoryState == "LEAVE_HOUSE" then
                task.spawn(function()
                    task.wait(0.5)
                    leaveHouse()
                    task.wait(1.5)
                    Settings.StoryState = "DONE"
                end)

            elseif Settings.StoryState == "DONE" then
                Settings.StoryState = "IDLE"
                Settings.AutoStory = false
                Settings.StoryDoorOpened = true
                if StoryToggle and StoryToggle.SetValue then
                    StoryToggle:SetValue(false)
                end
            end
        end

        -- Lógica de Auto Farm
        if Settings.AutoFarm and not Settings.AutoStory then
            if (tick() - lastQuestTime > 5) then
                lastQuestTime = tick()
                if Settings.AutoQuest then acceptQuest(false) end
            end

            equipWeapon()
            local target = getClosestEnemy()
            
            if target then
                local tHrp = target:FindFirstChild("HumanoidRootPart")
                if tHrp then
                    local distance = (tHrp.Position - hrp.Position).Magnitude
                    local destination = tHrp.CFrame * CFrame.new(0, 0, Settings.Distance)
                    
                    local travelTime = distance / Settings.FlightSpeed
                    if travelTime <= 0 then travelTime = 0.01 end
                    
                    local startPos = hrp.Position
                    local flyTween = TweenService:Create(hrp, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {CFrame = destination})
                    
                    flyTween:Play()
                    flyTween.Completed:Wait()
                    
                    local endPos = hrp.Position
                    local expectedDist = (destination.Position - startPos).Magnitude
                    local actualDist = (endPos - startPos).Magnitude
                    
                    if actualDist < (expectedDist * 0.5) and expectedDist > 15 then
                        stuckCounter = stuckCounter + 1
                        Settings.FlightSpeed = math.max(50, Settings.FlightSpeed * 0.7)
                        if stuckCounter >= 3 then stuckCounter = 0 end
                    else
                        stuckCounter = 0
                        if Settings.FlightSpeed < Settings.BaseSpeed then
                            Settings.FlightSpeed = math.min(Settings.BaseSpeed, Settings.FlightSpeed + 5)
                        end
                    end

                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then tool:Activate() end
                end
            end
        end
    end
end)