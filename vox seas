-- LARP's Auto-Farm: Step 1 - Quest NPC Navigation & Accept
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local localPlayer = Players.LocalPlayer

-- Parsed exact CFrame provided
local targetCFrame = CFrame.new(
    -143.089233, 20.8761578, 325.018066,
    -0.367537022, 0, -0.93001014,
    0, 1, 0,
    0.93001014, 0, -0.367537051
)

local function navigateAndAccept()
    local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local humanoid = char:WaitForChild("Humanoid")
    
    -- Temporarily disable collision to prevent getting stuck on terrain during tween
    local noclipConnection
    noclipConnection = RunService.Stepped:Connect(function()
        if char and hrp then
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") and v.CanCollide then
                    v.CanCollide = false
                end
            end
        end
    end)

    -- Smooth precise tween to the quest NPC
    local tweenInfo = TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    tween.Completed:Wait()
    
    -- Cleanup noclip immediately after arriving
    if noclipConnection then 
        noclipConnection:Disconnect() 
    end
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = true end
    end

    -- Fire the server remote to accept the quest
    local questRemote = ReplicatedStorage:WaitForChild("NetworkInstances"):WaitForChild("RemoteEvents"):WaitForChild("Quests")
    local args = {
        [1] = "AcceptGrinding",
        [2] = "Defeat Pirates"
    }
    
    questRemote:FireServer(unpack(args))
    print("[LARP] Quest accepted. Now go kill some fucks.")
end

navigateAndAccept()