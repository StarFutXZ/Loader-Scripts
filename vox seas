task.spawn(function()
    while true do
        task.wait(0.2)
        if CFG.Magnet and not isDoingQuest then
            local _, hrp = getChar()
            if hrp then
                local targets = findTargets(CFG.MagnetRadius)
                for _, t in ipairs(targets) do
                    if t.root and t.hum.Health > 0 then
                        t.root.CFrame = hrp.CFrame + Vector3.new(math.random(-4, 4), 0, math.random(-4, 4))
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(CFG.AttackDelay)
        if CFG.AutoFarm and not CFG.Magnet and not isDoingQuest then
            local c, hrp, hum = getChar()
            if c and hum.Health > 0 then
                local targets = findTargets(CFG.Radius)
                if #targets > 0 then
                    local t = targets[1]
                    local dir = (hrp.Position - t.root.Position).Unit
                    hrp.CFrame = t.root.CFrame + dir * 4 + Vector3.new(0, 2, 0)
                    swing()
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.15)
        if CFG.KillAura and not isDoingQuest then
            local targets = findTargets(CFG.Radius)
            if #targets > 0 then swing() end
        end
    end
end)

