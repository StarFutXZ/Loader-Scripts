-- Alvos por level
local function getTargetsForLevel()
    local lvl = 1
    local stats = LP:FindFirstChild("leaderstats")
    if stats and stats:FindFirstChild("Level") then
        lvl = stats.Level.Value
    elseif stats and stats:FindFirstChild("Lvl") then
        lvl = stats.Lvl.Value
    end

    if lvl < 5 then
        return {"cutlass pirate", "flint pirate"}
    else
        return {"marine recruit", "marine corporal", "corrupt marine"}
    end
end

--=============================================================
-- HELPERS
--=============================================================
local function getChar()
    local c = LP.Character
    if not c then return nil end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then return c, hrp, hum end
    return nil
end

local function equipWeapon()
    local c = LP.Character
    if not c then return nil end
    local tool = c:FindFirstChildOfClass("Tool")
    if not tool then
        local bp = LP:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") then
                    c:FindFirstChildOfClass("Humanoid"):EquipTool(t)
                    task.wait(0.05)
                    return t
                end
            end
        end
    end
    return tool
end

local function swing()
    local tool = equipWeapon()
    if tool then
        pcall(function()
            tool:Activate()
            local rem = tool:FindFirstChild("Remote") or tool:FindFirstChildWhichIsA("RemoteEvent")
            if rem then rem:FireServer() end
        end)
    end
end

local function findTargets(radius)
    local list = {}
    local _, hrp = getChar()
    if not hrp then return list end
    local targets = getTargetsForLevel()

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local lowerName = obj.Name:lower()
            for _, targetName in ipairs(targets) do
                if lowerName:find(targetName) then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    local root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                    if hum and hum.Health > 0 and root then
                        local d = (root.Position - hrp.Position).Magnitude
                        if d <= radius then
                            table.insert(list, {model = obj, root = root, hum = hum, dist = d})
                        end
                        break
                    end
                end
            end
        end
    end
    return list
end

local function doSolmarQuest()
    local _, hrp = getChar()
    if not hrp then return end

    local giverModel = nil
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower():find("solmar") and obj.Name:lower():find("giver") then
            giverModel = obj
            break
        end
    end

    if giverModel then
        local pos = giverModel:FindFirstChild("HumanoidRootPart") or giverModel.PrimaryPart
        if pos then
            hrp.CFrame = pos.CFrame + Vector3.new(0, 3, 0)
            task.wait(0.3)
            
            for _, prompt in ipairs(giverModel:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    fireproximityprompt(prompt)
                    task.wait(0.5)
                    break
                end
            end

            for _, gui in ipairs(PG:GetDescendants()) do
                if gui:IsA("TextButton") then
                    local txt = gui.Text:lower()
                    if txt:find("accept") or txt:find("aceitar") then
                        gui:Click()
                        break
                    end
                end
            end
        end
    end
end

--=============================================================
-- LOOPS
--=============================================================
task.spawn(function()
    while true do
        task.wait(0.2)
        if CFG.Magnet then
            local _, hrp = getChar()
            if hrp then
                local targets = findTargets(CFG.MagnetRadius)
                for i, t in ipairs(targets) do
                    if t.root and t.hum.Health > 0 then
                        local offset = Vector3.new(math.random(-4, 4), 0, math.random(-4, 4))
                        t.root.CFrame = hrp.CFrame + offset
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(CFG.AttackDelay)
        if CFG.AutoFarm and not CFG.Magnet then
            local c, hrp, hum = getChar()
            if c and hum.Health > 0 then
                local targets = findTargets(CFG.Radius)
                if #targets > 0 then
                    local t = targets[1]
                    local dir = (hrp.Position - t.root.Position).Unit
                    hrp.CFrame = t.root.CFrame + dir * 4 + Vector3.new(0, 2, 0)
                    swing()
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.15)
        if CFG.KillAura then
            local targets = findTargets(CFG.Radius)
            if #targets > 0 then swing() end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(3)
        if CFG.AutoQuest then doSolmarQuest() end
    end
end)

