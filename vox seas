local function makeToggle(name, key, order)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 28)
    btn.BackgroundColor3 = Color3.fromRGB(30, 36, 44)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.Code
    btn.TextSize = 12
    btn.TextColor3 = Color3.fromRGB(220, 226, 232)
    btn.Text = "[ OFF ]  " .. name
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = order
    btn.Parent = list
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local pd = Instance.new("UIPadding", btn)
    pd.PaddingLeft = UDim.new(0, 10)

    btn.MouseButton1Click:Connect(function()
        CFG[key] = not CFG[key]
        btn.Text = string.format("[ %s ]  %s", CFG[key] and "ON " or "OFF", name)
        btn.TextColor3 = CFG[key] and CFG.Accent or Color3.fromRGB(220, 226, 232)
    end)
end

