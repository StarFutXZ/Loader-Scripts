-- Helper: Toggle Premium (Switch Animado)
local function createSwitch(parent, text, key, order, defaultState)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 35)
    container.BackgroundTransparency = 1
    container.LayoutOrder = order
    container.Parent = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -60, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 13
    lbl.TextColor3 = CFG.TextColor
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = text
    lbl.Parent = container

    local switchBg = Instance.new("TextButton")
    switchBg.Size = UDim2.fromOffset(40, 20)
    switchBg.Position = UDim2.new(1, -40, 0.5, -10)
    switchBg.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    switchBg.Text = ""
    switchBg.AutoButtonColor = false
    switchBg.Parent = container
    Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(16, 16)
    knob.Position = UDim2.new(0, 2, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
    knob.Parent = switchBg
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local isOn = CFG[key]
    
    local function updateVisuals()
        local targetPos = isOn and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        local targetBg = isOn and CFG.Accent or Color3.fromRGB(50, 50, 60)
        local targetKnob = isOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 150)
        
        TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Position = targetPos, BackgroundColor3 = targetKnob}):Play()
        TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = targetBg}):Play()
    end

    if isOn then updateVisuals() end

    switchBg.MouseButton1Click:Connect(function()
        isOn = not isOn
        CFG[key] = isOn
        updateVisuals()
    end)
end

