local function acceptQuest()
    local questRemote = ReplicatedStorage:WaitForChild("NetworkInstances"):WaitForChild("RemoteEvents"):WaitForChild("Quests")
    questRemote:FireServer(unpack({ [1] = "AcceptGrinding", [2] = Settings.SelectedQuest }))
end

local function enterHouse()
    game:GetService("ReplicatedStorage"):WaitForChild("NetworkInstances"):WaitForChild("RemoteEvents"):WaitForChild("PrivateAreas"):FireServer(unpack({ [1] = "EnterArea", [2] = "ElderHouseEnter" }))
end

local function talkToNPC()
    game:GetService("ReplicatedStorage"):WaitForChild("NetworkInstances"):WaitForChild("RemoteEvents"):WaitForChild("Elysium_Converse"):FireServer(unpack({ [1] = "Talk_VillageChief" }))
end

local function leaveHouse()
    game:GetService("ReplicatedStorage"):WaitForChild("NetworkInstances"):WaitForChild("RemoteEvents"):WaitForChild("PrivateAreas"):FireServer(unpack({ [1] = "EnterArea", [2] = "ElderHouseLeave" }))
end

-- ==========================================
-- NOCLIP BLINDADO
-- ==========================================
local noclipConnection = nil
local function applyNoclip()
    local char = localPlayer.Character
    if char then
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
end

task.spawn(function()
    while task.wait(0.2) do
        if Settings.Noclip then
            if not noclipConnection then
                noclipConnection = RunService.Stepped:Connect(applyNoclip)
            end
            applyNoclip()
        else
            if noclipConnection then
                noclipConnection:Disconnect()
                noclipConnection = nil
                local char = localPlayer.Character
                if char then
                    for _, v in pairs(char:GetDescendants()) do
                        if v:IsA("BasePart") then v.CanCollide = true end
                    end
                end
            end
        end
    end
end)

-- ==========================================
-- LOOP PRINCIPAL
-- ==========================================
task.spawn(function()
    local lastQuestTime = 0
    
    while task.wait() do
        local char = localPlayer.Character
        if not char or not char.Parent then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end

        -- Lógica da História
        if Settings.AutoStory and not Settings.ExecutingStory then
            Settings.ExecutingStory = true
            
            task.spawn(function()
                local function flyTo(target)
                    if not Settings.AutoStory then return false end
                    local dist = (target.Position - hrp.Position).Magnitude
                    local time = dist / Settings.FlightSpeed
                    if time <= 0 then time = 0.01 end
                    
                    local tween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = target})
                    tween:Play()
                    tween.Completed:Wait()
                    
                    hrp.CFrame = target
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    return true
                end

                if flyTo(Coords.House) then
                    task.wait(0.5)
                    enterHouse()
                    task.wait(2)
                    if flyTo(Coords.NPC) then
                        task.wait(0.5)
                        talkToNPC()
                        task.wait(2)
                        if flyTo(Coords.ExitDoor) then
                            task.wait(0.5)
                            leaveHouse()
                            task.wait(2)
                        end
                    end
                end

                Settings.AutoStory = false
                Settings.ExecutingStory = false
                if StoryToggle and StoryToggle.SetValue then
                    StoryToggle:SetValue(false)
                end
            end)
        end

        -- Lógica do Auto Farm
        if Settings.AutoFarm and not Settings.ExecutingStory then
            if (tick() - lastQuestTime > 5) then
                lastQuestTime = tick()
                if Settings.AutoQuest then acceptQuest() end
            end

            equipWeapon()
            local target = getClosestEnemy()
            
            if target then
                local tHrp = target:FindFirstChild("HumanoidRootPart")
                if tHrp then
                    local distance = (tHrp.Position - hrp.Position).Magnitude
                    local destination = tHrp.CFrame * CFrame.new(0, 0, Settings.Distance)
                    local travelTime = distance / Settings.FlightSpeed
                    if travelTime <= 0 then travelTime = 0.01 end
                    
                    local flyTween = TweenService:Create(hrp, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {CFrame = destination})
                    flyTween:Play()
                    flyTween.Completed:Wait()
                    
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then tool:Activate() end
                end
            end
        end
    end
end)

