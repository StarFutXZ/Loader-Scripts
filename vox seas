--=============================================================
-- HELPERS
--=============================================================
local function getChar()
    local c = LP.Character
    if not c then return nil end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hrp and hum then return c, hrp, hum end
    return nil
end

local function isPlayerModel(m)
    return Players:GetPlayerFromCharacter(m) ~= nil
end

local function alive(hum)
    return hum and hum.Health > 0
end

local function equipTool()
    local _, _, hum = getChar()
    if not hum then return nil end
    local tool = LP.Character:FindFirstChildOfClass("Tool")
    if not tool then
        local bp = LP:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") then
                    hum:EquipTool(t)
                    task.wait(0.05)
                    return t
                end
            end
        end
    end
    return tool
end

--=============================================================
-- REMOTE SNIFFER (fallback pra achar remote de dano)
--=============================================================
local damageRemotes = {}
local function sniffRemotes(container)
    for _, obj in ipairs(container:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local n = obj.Name:lower()
            if n:find("attack") or n:find("damage") or n:find("hit")
            or n:find("combat") or n:find("m1") or n:find("swing") then
                damageRemotes[obj] = true
            end
        end
    end
end
pcall(sniffRemotes, ReplicatedStorage)
pcall(sniffRemotes, Workspace)

local function fireDamage(target)
    if not CFG.UseRemoteDmg then return false end
    local fired = false
    for remote in pairs(damageRemotes) do
        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer(target)
            else
                remote:InvokeServer(target)
            end
            fired = true
        end)
    end
    return fired
end

--=============================================================
-- COMBATE
--=============================================================
local function swing(target)
    local tool = equipTool()
    if tool then
        pcall(function()
            tool:Activate()
            local r = tool:FindFirstChild("Remote") or tool:FindFirstChild("Event")
            if r and r:IsA("RemoteEvent") then
                if target then r:FireServer(target) else r:FireServer() end
            end
        end)
    end
    if target then fireDamage(target) end
end

local function findEnemies(radius)
    local list = {}
    local _, hrp = getChar()
    if not hrp then return list end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and not isPlayerModel(obj) then
            local hum  = obj:FindFirstChildOfClass("Humanoid")
            local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj.PrimaryPart
            if alive(hum) and root then
                local d = (root.Position - hrp.Position).Magnitude
                if d <= radius then
                    table.insert(list, {model = obj, root = root, hum = hum, dist = d})
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

local function findNamed(radius, ...)
    local names = {...}
    local list = {}
    local _, hrp = getChar()
    if not hrp then return list end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local n = obj.Name:lower()
            for _, key in ipairs(names) do
                if n:find(key) then
                    local pos = obj:IsA("BasePart") and obj
                        or (obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart"))
                    if pos then
                        local d = (pos.Position - hrp.Position).Magnitude
                        if d <= radius then
                            table.insert(list, {obj = obj, pos = pos, dist = d})
                        end
                    end
                    break
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

local function triggerPromptNear(pos, radius)
    radius = radius or 15
    local best, bestD
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local parent = obj.Parent
            local ppos = parent and (
                parent:IsA("BasePart") and parent.Position
                or parent:IsA("Model") and (parent.PrimaryPart and parent.PrimaryPart.Position)
            )
            if ppos then
                local d = (ppos - pos).Magnitude
                if d <= radius and (not bestD or d < bestD) then
                    best, bestD = obj, d
                end
            end
        end
    end
    if best then
        pcall(function() fireproximityprompt(best) end)
        return true
    end
    return false
end

local function tp(cf)
    local _, hrp = getChar()
    if hrp then hrp.CFrame = cf end
end

local function tpToTarget(root, offset)
    local _, hrp = getChar()
    if not hrp then return end
    local dir = (hrp.Position - root.Position)
    if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, 1) end
    dir = dir.Unit
    tp(root.CFrame + dir * (offset or 6) + Vector3.new(0, CFG.TpHeight, 0))
end

