local function acceptQuest(isStory)
    local questRemote = ReplicatedStorage:WaitForChild("NetworkInstances"):WaitForChild("RemoteEvents"):WaitForChild("Quests")
    
    if isStory then
        local args = { [1] = "AcceptStory", [2] = Settings.SelectedStory }
        questRemote:FireServer(unpack(args))
        print("[LARP] Story Quest puxada:", Settings.SelectedStory)
    else
        local args = { [1] = "AcceptGrinding", [2] = Settings.SelectedQuest }
        questRemote:FireServer(unpack(args))
        print("[LARP] Grinding Quest puxada:", Settings.SelectedQuest)
    end
end

-- A PORRA DO TEU CÓDIGO EXATO AQUI
local function enterStoryHouse()
    local args = {
        [1] = "EnterArea",
        [2] = "ElderHouseEnter"
    }
    game:GetService("ReplicatedStorage"):WaitForChild("NetworkInstances"):WaitForChild("RemoteEvents"):WaitForChild("PrivateAreas"):FireServer(unpack(args))
    print("[LARP] Invadindo a porra da casa do velho...")
end

-- Loop Principal
task.spawn(function()
    local noclipConnection
    local lastQuestTime = 0
    local stuckCounter = 0
    local storyFlyTween = nil

    while task.wait() do
        local char = localPlayer.Character
        if not char or not char.Parent then continue end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end

        -- Noclip
        if (Settings.AutoFarm or Settings.AutoStory) and not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                if char then
                    for _, v in pairs(char:GetDescendants()) do
                        if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
                    end
                end
            end)
        elseif not (Settings.AutoFarm or Settings.AutoStory) and noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = true end
            end
        end

        -- ==========================================
        -- LÓGICA DA QUEST DE HISTÓRIA (MÁQUINA DE ESTADOS)
        -- ==========================================
        if Settings.AutoStory and not Settings.StoryDoorOpened then
            local distance = (StoryHouseCFrame.Position - hrp.Position).Magnitude
            
            -- Estado 1: Voando pra porra da casa
            if Settings.StoryState == "IDLE" and distance > 5 then
                Settings.StoryState = "FLYING"
                local travelTime = distance / Settings.FlightSpeed
                if travelTime <= 0 then travelTime = 0.01 end
                
                storyFlyTween = TweenService:Create(hrp, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {CFrame = StoryHouseCFrame})
                storyFlyTween:Play()
            end

            -- Estado 2: Chegou perto, para a porra do boneco
            if distance <= 5 and Settings.StoryState == "FLYING" then
                Settings.StoryState = "STOPPING"
                
                if storyFlyTween then
                    storyFlyTween:Cancel()
                    storyFlyTween = nil
                end
                
                -- Crava no chão e zera a velocidade
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                hrp.CFrame = StoryHouseCFrame
                
                -- Estado 3: Espera o servidor registrar que ele parou e ENTRA
                task.spawn(function()
                    task.wait(0.5) -- Meio segundo de segurança
                    if Settings.StoryState == "STOPPING" then
                        Settings.StoryState = "ENTERING"
                        enterStoryHouse()
                        
                        Settings.StoryDoorOpened = true
                        Settings.AutoStory = false 
                        if StoryToggle and StoryToggle.SetValue then
                            StoryToggle:SetValue(false)
                        end
                    end
                end)
            end
        elseif not Settings.AutoStory and Settings.StoryState ~= "IDLE" then
            -- Reset de segurança se o usuário desligar no meio do caminho
            if storyFlyTween then storyFlyTween:Cancel() end
            Settings.StoryState = "IDLE"
        end

        -- ==========================================
        -- LÓGICA DE AUTO FARM (SECUNDÁRIA)
        -- ==========================================
        if Settings.AutoFarm and not Settings.AutoStory then
            if (tick() - lastQuestTime > 5) then
                lastQuestTime = tick()
                if Settings.AutoQuest then acceptQuest(false) end
            end

            equipWeapon()
            local target = getClosestEnemy()
            
            if target then
                local tHrp = target:FindFirstChild("HumanoidRootPart")
                if tHrp then
                    local distance = (tHrp.Position - hrp.Position).Magnitude
                    local destination = tHrp.CFrame * CFrame.new(0, 0, Settings.Distance)
                    
                    local travelTime = distance / Settings.FlightSpeed
                    if travelTime <= 0 then travelTime = 0.01 end
                    
                    local startPos = hrp.Position
                    local flyTween = TweenService:Create(hrp, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {CFrame = destination})
                    
                    flyTween:Play()
                    flyTween.Completed:Wait()
                    
                    -- Sistema anti-rubberband
                    local endPos = hrp.Position
                    local expectedDist = (destination.Position - startPos).Magnitude
                    local actualDist = (endPos - startPos).Magnitude
                    
                    if actualDist < (expectedDist * 0.5) and expectedDist > 15 then
                        stuckCounter = stuckCounter + 1
                        Settings.FlightSpeed = math.max(50, Settings.FlightSpeed * 0.7)
                        
                        if stuckCounter >= 3 then
                            print("[LARP] Anti-cheat tá puxando de volta. Velocidade reduzida:", math.floor(Settings.FlightSpeed))
                            stuckCounter = 0
                        end
                    else
                        stuckCounter = 0
                        if Settings.FlightSpeed < Settings.BaseSpeed then
                            Settings.FlightSpeed = math.min(Settings.BaseSpeed, Settings.FlightSpeed + 5)
                        end
                    end

                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        tool:Activate()
                    end
                end
            end
        end
    end
end)

print("[LARP] Máquina de estados ativada. O boneco agora para, respira e invade a porra da casa.")