--=============================================================
-- LÓGICA DE CLIQUE ABSOLUTO (VirtualUser)
--=============================================================
local function mouseClickButton(btn)
    if not btn or not btn.Visible then return false end
    local pos, size = btn.AbsolutePosition, btn.AbsoluteSize
    if size.X > 0 and size.Y > 0 then
        local center = Vector2.new(pos.X + size.X/2, pos.Y + size.Y/2)
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:Button1Down(center)
            task.wait(0.05)
            VirtualUser:Button1Up(center)
        end)
        return true
    end
    return false
end

local function smartClick(textToFind)
    local lowerText = textToFind:lower()
    for _, obj in ipairs(game:GetDescendants()) do
        if (obj:IsA("TextButton") or obj:IsA("ImageButton")) and obj.Visible then
            local txt = ""
            if obj:IsA("TextButton") then txt = obj.Text:lower() end
            for _, desc in ipairs(obj:GetDescendants()) do
                if desc:IsA("TextLabel") and desc.Visible then
                    txt = txt .. " " .. desc.Text:lower()
                end
            end
            
            -- Checa se o texto bate e se o botão está na tela
            if txt:find(lowerText) and obj.AbsoluteSize.X > 0 then
                if mouseClickButton(obj) then
                    return true
                end
            end
        end
    end
    return false
end

--=============================================================
-- HELPERS DE FARM
--=============================================================
local function getChar()
    local c = LP.Character
    if not c then return nil end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then return c, hrp, hum end
    return nil
end

local function getTargetsForLevel()
    local lvl = 1
    local stats = LP:FindFirstChild("leaderstats")
    if stats and stats:FindFirstChild("Level") then lvl = stats.Level.Value
    elseif stats and stats:FindFirstChild("Lvl") then lvl = stats.Lvl.Value end

    if lvl < 5 then
        return {"cutlass pirate", "flint pirate", "bandit"}
    else
        return {"marine recruit", "marine corporal", "corrupt marine", "bandit enforcer"}
    end
end

local function swing()
    local c = LP.Character
    if not c then return end
    local tool = c:FindFirstChildOfClass("Tool")
    if not tool then
        local bp = LP:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") then
                    c:FindFirstChildOfClass("Humanoid"):EquipTool(t)
                    task.wait(0.05)
                    tool = t
                    break
                end
            end
        end
    end
    if tool then
        pcall(function()
            tool:Activate()
            local rem = tool:FindFirstChild("Remote") or tool:FindFirstChildWhichIsA("RemoteEvent")
            if rem then rem:FireServer() end
        end)
    end
end

local function findTargets(radius)
    local list = {}
    local _, hrp = getChar()
    if not hrp then return list end
    local targets = getTargetsForLevel()

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local lowerName = obj.Name:lower()
            for _, targetName in ipairs(targets) do
                if lowerName:find(targetName) then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    local root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                    if hum and hum.Health > 0 and root then
                        local d = (root.Position - hrp.Position).Magnitude
                        if d <= radius then
                            table.insert(list, {model = obj, root = root, hum = hum, dist = d})
                        end
                        break
                    end
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

--=============================================================
-- LÓGICA DA QUEST DEFINITIVA
--=============================================================
local function doSolmarQuest()
    if isDoingQuest then return end
    isDoingQuest = true
    
    local _, hrp = getChar()
    if not hrp then isDoingQuest = false return end

    updateStatus("Procurando NPC...")
    local giverModel = nil
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower():find("solmar") then
            giverModel = obj
            break
        end
    end

    if giverModel then
        updateStatus("Teleportando...")
        local pos = giverModel:FindFirstChild("HumanoidRootPart") or giverModel.PrimaryPart
        
        if pos then
            -- Teleporta pra frente do NPC
            hrp.CFrame = pos.CFrame * CFrame.new(0, 0, 4)
            task.wait(1.5)
            
            -- Tenta clicar no "Conversar" flutuante primeiro
            updateStatus("Clicando 'Conversar'...")
            smartClick("conversar")
            task.wait(1)
            
            -- Se não abriu, tenta forçar ProximityPrompt / ClickDetector
            for _, prompt in ipairs(giverModel:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then fireproximityprompt(prompt) end
                if prompt:IsA("ClickDetector") then fireclickdetector(prompt) end
            end
            task.wait(1)
            smartClick("conversar") -- Tenta de novo
            
            -- Avança no diálogo
            task.wait(1)
            updateStatus("Aceitando Missão...")
            smartClick("mostre-me")
            smartClick("mostrar")
            task.wait(1)
            smartClick("aceitar")
            smartClick("accept")
            
            -- Fecha
            task.wait(1)
            smartClick("fechar")
            smartClick("x")
            
            updateStatus("Missão Coletada!")
            task.wait(2)
        end
    else
        updateStatus("NPC nao encontrado!")
        task.wait(1)
    end
    
    isDoingQuest = false
end

