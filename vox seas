local function acceptQuest(isStory)
    local questRemote = ReplicatedStorage:WaitForChild("NetworkInstances"):WaitForChild("RemoteEvents"):WaitForChild("Quests")
    
    if isStory then
        local args = { [1] = "AcceptStory", [2] = Settings.SelectedStory }
        questRemote:FireServer(unpack(args))
    else
        local args = { [1] = "AcceptGrinding", [2] = Settings.SelectedQuest }
        questRemote:FireServer(unpack(args))
    end
end

local function enterHouse()
    local args = { [1] = "EnterArea", [2] = "ElderHouseEnter" }
