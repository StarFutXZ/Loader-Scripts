        if obj:IsA("Model") and obj ~= char then
            if string.find(string.lower(obj.Name), string.lower(targetName)) then
                local tHrp = obj:FindFirstChild("HumanoidRootPart")
                local hum = obj:FindFirstChild("Humanoid")
                if tHrp and hum and hum.Health > 0 then
                    local d = (tHrp.Position - hrp.Position).Magnitude
                    if d < dist then
                        dist = d
                        closest = obj
                    end
                end
            end
        end
    end
    return closest
end

local function executeQuestLogic()
    if not CombatSettings.AutoQuest then return end
    
    local questRemote = ReplicatedStorage:WaitForChild("NetworkInstances"):WaitForChild("RemoteEvents"):WaitForChild("Quests")
    local selectedQuest = questDropdown.Value
    if type(selectedQuest) == "table" then selectedQuest = selectedQuest[1] end
    
    local args = {
        [1] = "AcceptGrinding",
        [2] = tostring(selectedQuest)
    }
    
    questRemote:FireServer(unpack(args))
    print("[LARP] Missão aceita: " .. tostring(selectedQuest))
    task.wait(1)
end

