-- CONFIG
--=============================================================
local CFG = {
    Radius         = 500,
    AttackDelay    = 0.25,
    TeleportOffset = 4,
    AutoFarm       = false,
    AutoQuest      = false,
    KillAura       = false,
    AntiAFK        = true,
    Accent         = Color3.fromRGB(90, 200, 255),
    Bg             = Color3.fromRGB(14, 18, 24),
    -- NPCs exatos da primeira ilha baseados na sua print
    TargetNPCs     = {
        "cutlass pirate", 
        "flint pirate", 
        "marine recruit", 
        "marine corporal"
    }
}

--=============================================================
-- HELPERS
--=============================================================
local function getChar()
    local c = LP.Character
    if not c then return nil end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then return c, hrp, hum end
    return nil
end

local function equipWeapon()
    local c = LP.Character
    if not c then return nil end
    local tool = c:FindFirstChildOfClass("Tool")
    if not tool then
        local bp = LP:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") then
                    c:FindFirstChildOfClass("Humanoid"):EquipTool(t)
                    task.wait(0.05)
                    return t
                end
            end
        end
    end
    return tool
end

local function swing()
    local tool = equipWeapon()
    if tool then
        pcall(function()
            tool:Activate()
            local rem = tool:FindFirstChild("Remote") or tool:FindFirstChildWhichIsA("RemoteEvent")
            if rem then rem:FireServer() end
        end)
    end
end

local function isTarget(npcName)
    local lowerName = npcName:lower()
    for _, target in ipairs(CFG.TargetNPCs) do
        if lowerName:find(target) then return true end
    end
    return false
end

local function findTargets(radius)
    local list = {}
    local _, hrp = getChar()
    if not hrp then return list end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and isTarget(obj.Name) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
            if hum and hum.Health > 0 and root then
                local d = (root.Position - hrp.Position).Magnitude
                if d <= radius then
                    table.insert(list, {model = obj, root = root, dist = d})
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

--=============================================================
-- AUTO QUEST BOARD (Proximity + UI Clicker)
--=============================================================
local function handleQuestBoard()
    local _, hrp = getChar()
    if not hrp then return end

    -- 1. Acha o Quest Board físico
    local boardPrompt
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and (obj.Parent.Name:lower():find("quest") or obj.Parent.Name:lower():find("board")) then
            boardPrompt = obj
            break
        end
    end

    if boardPrompt then
        -- Teleporta pro board e interage
        local bPos = boardPrompt.Parent:IsA("BasePart") and boardPrompt.Parent.Position or boardPrompt.Parent.PrimaryPart.Position
        hrp.CFrame = CFrame.new(bPos + Vector3.new(0, 3, 0))
        task.wait(0.2)
        fireproximityprompt(boardPrompt)
        
        -- 2. Clica nos botões do UI (Accept / Claim / Complete)
        task.wait(0.5)
        for _, gui in ipairs(PG:GetDescendants()) do
            if gui:IsA("TextButton") then
                local txt = gui.Text:lower()
                if txt:find("accept") or txt:find("claim") or txt:find("complete") or txt:find("turn in") then
                    gui:Click() -- Usa o metatable padrão do executor
                    task.wait(0.1)
                end
            end
        end
        
        -- Fecha o UI se tiver um botão de fechar (X)
        for _, gui in ipairs(PG:GetDescendants()) do
            if gui:IsA("TextButton") and (gui.Text == "X" or gui.Name:lower() == "close") then
                gui:Click()
                break
            end
        end
    end
end

--=============================================================
-- LOOPS
--=============================================================
task.spawn(function() -- AUTO FARM
    while true do
        task.wait(CFG.AttackDelay)
        if CFG.AutoFarm then
            local c, hrp, hum = getChar()
            if c and hum.Health > 0 then
                local targets = findTargets(CFG.Radius)
                if targets[1] then
                    local t = targets[1]
                    local dir = (hrp.Position - t.root.Position).Unit
                    hrp.CFrame = t.root.CFrame + dir * CFG.TeleportOffset + Vector3.new(0, 2, 0)
                    swing()
                end
            end
        end
    end
end)

task.spawn(function() -- KILL AURA
    while true do
        task.wait(0.1)
        if CFG.KillAura then
            local targets = findTargets(45)
            if #targets > 0 then
                swing()
            end
        end
    end
end)

task.spawn(function() -- AUTO QUEST
    while true do
        task.wait(2)
        if CFG.AutoQuest then
            handleQuestBoard()
        end
    end
end)

